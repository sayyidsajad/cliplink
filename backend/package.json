{
  "name": "cliplink-backend",
  "private": true,
  "type": "module",
  "description": "ClipLink backend: Cloudflare Worker + R2 storage + D1 metadata",
  "scripts": {
    "dev": "wrangler dev --port 8787 --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute cliplink --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute cliplink --remote --file=schema.sql",
    "test": "bash ../scripts/test-backend.sh"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  },
  "dependencies": {
    "supabase": "^2.122.0"
  }
}
